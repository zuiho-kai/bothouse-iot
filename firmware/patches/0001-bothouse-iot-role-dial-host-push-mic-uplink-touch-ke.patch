+// Colours from dial.html.
+// kScreenBg also fills the bands of a non-square screen around the canvas (design doc 5.1 rule 3).
+constexpr uint32_t kScreenBg = 0x1b1d21;   // .screen background
+constexpr uint32_t kRed = 0xf05454;        // interrupted ring
+constexpr uint32_t kUnknownRole = 0x9aa0a6;  // dial.html colour for a role it has no preset for
+
+// Timings from dial.html (ms).
+constexpr float kBreatheIdleMs = 4600;   // @keyframes breathe, idle
+constexpr float kGlintMs = 9000;         // @keyframes glint
+constexpr float kSpinMs = 1600;          // thinking ring spin (linear, like the web)
+// Animation timer and display refresh period. 30, not 33: an lv_timer that runs late restarts its
+// period from the late run, so 33 ms gave 25.7 runs/s on the board (2026-10-19, FreeRTOS 1000 Hz).
+constexpr uint32_t kFrameMs = 30;
+// Smoothing time constants (ms) of the one-pole "follow" filters below. Each is about a third of
+// the matching CSS transition so the move is ~95% done when the web one ends: .face opacity .6s,
+// .ring .3s, .face filter .3s. Level attack/release: implementer's pick so the glow follows
+// syllables (60 ms Opus frames) without flicker.
+constexpr float kTauFace = 200, kTauRing = 100, kTauGray = 100;
+constexpr float kTauLevelUp = 50, kTauLevelDown = 160;
+// Real audio level counts as "current" this long after the last played chunk; after that the
+// synthetic wave of dial.html level() is used (between sentences, or before audio arrives).
+// Source: implementer's pick, a few 60 ms frames.
+constexpr int64_t kLevelFreshUs = 300 * 1000;
+
+// Ring sizes are not here: they come from cn_dial (conest firmware/dial/layout/dial-layout.v1.json,
+// rh_dial.* items), see RhDialDisplay::MakeSizes. Idle halo and speaking glow are new on the board
+// (the web glows outside the bezel, which the board has not); their widths were picked by eye on
+// the 240 board 2026-10-19 and do not scale yet (fixed_px).
+constexpr float kHaloOpaMin = .18f, kHaloOpaMax = .5f;
+
+// Glint: dial.html .glint = linear-gradient(115deg, transparent 38%, white .16 at 48%, transparent
+// 58%) over a 250% wide box, i.e. a band half a screen wide whose lines lean 25 deg (top to the right).
+constexpr float kGlintTan = 0.4663f;  // tan(25 deg)
+constexpr lv_opa_t kGlintPeak = 41;   // .16 * 255
+
+float Clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
+float Smooth(float u) { u = Clamp01(u); return u * u * (3 - 2 * u); }  // ease-in-out
+// t is milliseconds since boot as a double (exact for centuries): each cycle is reduced by its own
+// period in double, so phases stay continuous (no hourly wrap jump) and keep float precision.
+float Cyc(double t, float period) { return (float)fmod(t, period); }  // [0, period)
+float Ang(double t, float div) { return (float)fmod(t / div, 2 * M_PI); }  // t/div as an angle, radians
+float Wave(double t, float period) { return (1 - cosf(2 * (float)M_PI * Cyc(t, period) / period)) / 2; }
+// One-pole low-pass: moves towards target fast first, then slowly (ease-out), frame-rate independent.
+float Follow(float cur, float target, float dt, float tau) { return cur + (target - cur) * (1 - expf(-dt / tau)); }
+
+// Set a local style property only when it changes: setting one always invalidates the object,
+// and the timer runs every frame.
+void Num(lv_obj_t* o, lv_style_prop_t p, int32_t v, lv_style_selector_t sel = 0) {
+    lv_style_value_t cur;
+    if (lv_obj_get_local_style_prop(o, p, &cur, sel) == LV_STYLE_RES_FOUND && cur.num == v) return;
+    lv_style_value_t nv;
+    nv.num = v;
+    lv_obj_set_local_style_prop(o, p, nv, sel);
+}
+void Col(lv_obj_t* o, lv_style_prop_t p, lv_color_t v, lv_style_selector_t sel = 0) {
+    lv_style_value_t cur;
+    if (lv_obj_get_local_style_prop(o, p, &cur, sel) == LV_STYLE_RES_FOUND && lv_color_eq(cur.color, v)) return;
+    lv_style_value_t nv;
+    nv.color = v;
+    lv_obj_set_local_style_prop(o, p, nv, sel);
+}
+
+void Plain(lv_obj_t* o) {
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+}
+
+void Show(lv_obj_t* o, bool on) {
+    if (on) lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+    else lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+}
