@@ -349,6 +351,18 @@ void AudioService::AudioOutputTask() {
         }
 
         codec_->OutputData(task.pcm);
+#if CONFIG_RH_DIAL
+        if (!task.pcm.empty()) {
+            // rh dial: RMS of this chunk; full level at RMS = 40/128 of full scale, the same
+            // mapping as rh/static/dial.html level() (8-bit time-domain RMS / 40).
+            int64_t sum = 0;
+            for (int16_t v : task.pcm) sum += (int32_t)v * v;
+            float rms = sqrtf((float)sum / task.pcm.size());
+            float lv = rms / (32768.0f * 40.0f / 128.0f);
+            g_rh_out_level.store((uint16_t)(lv >= 1.0f ? 1000 : lv * 1000));
+            g_rh_out_level_us.store(esp_timer_get_time());
+        }
+#endif
 
         /* Update the last output time */
         last_output_time_ = std::chrono::steady_clock::now();
