@@ -360,6 +383,44 @@ void Application::HandleActivationDoneEvent() {
             audio_service_.PlaySound(Lang::Sounds::OGG_SUCCESS);
         });
     }
+
+#if CONFIG_RH_HOST_PUSH
+    // rh (a): network + OTA done -> open the audio channel now, without waiting for a
+    // button press, so the host can push tts at any time. Source: host side c3bba51
+    // rh/xiaozhi.py, maintainer 2026-10-19.
+    RhScheduleOpenChannel(0);
+#endif
+}
+
+void Application::RhScheduleOpenChannel(int delay_sec) {
+    rh_reopen_at_us_ = esp_timer_get_time() + (int64_t)delay_sec * 1000000;
+}
+
+void Application::RhTryOpenChannel() {
+    // rh: main task only. Opens the channel when idle; otherwise (or on failure) retries later.
+    rh_reopen_at_us_ = -1;
+    if (!protocol_ || protocol_->IsAudioChannelOpened()) {
+        return;
+    }
+    if (GetDeviceState() != kDeviceStateIdle) {
+        RhScheduleOpenChannel(CONFIG_RH_REOPEN_DELAY_SEC);
+        return;
+    }
+    ESP_LOGI(TAG, "rh: opening audio channel for host push");
+    if (protocol_->OpenAudioChannel()) {
+        DismissAlert();  // clear a "server not connected" error left by an earlier failed try
+#if CONFIG_RH_ALWAYS_LISTEN
+        // rh: stream the mic to the host right away (host-side wake word, see Kconfig RH_ALWAYS_LISTEN).
+        Schedule([this]() {
+            if (GetDeviceState() == kDeviceStateIdle && protocol_->IsAudioChannelOpened()) {
+                ESP_LOGI(TAG, "rh: always listen -> listening");
+                SetListeningMode(GetDefaultListeningMode());
+            }
+        });
+#endif
+    } else {
+        RhScheduleOpenChannel(CONFIG_RH_REOPEN_DELAY_SEC);
+    }
 }
 
