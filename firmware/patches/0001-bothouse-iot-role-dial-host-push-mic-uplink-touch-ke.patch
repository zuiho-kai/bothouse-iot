+// One strip of the tilted glint band (ARGB8888, straight alpha), reused for every strip. The band
+// sweeps the canvas (the avatar), not the bands of a non-square screen.
+void RhDialDisplay::BuildGlint() {
+    const int C = metrics_.canvas();
+    const int strip_h = C / kGlintStrips;
+    const float half = C / 4.0f;  // band half width
+    const int sw = (int)ceilf(2 * half + strip_h * kGlintTan) + 2;
+    glint_px_ = static_cast<uint8_t*>(heap_caps_malloc(sw * strip_h * 4, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (glint_px_ == nullptr) return;
+    for (int y = 0; y < strip_h; y++) {
+        float cx = sw / 2.0f + (strip_h / 2.0f - y - 0.5f) * kGlintTan;
+        for (int x = 0; x < sw; x++) {
+            float a = 1 - fabsf(x + 0.5f - cx) / half;
+            uint8_t* p = glint_px_ + (y * sw + x) * 4;
+            p[0] = p[1] = p[2] = 0xff;
+            p[3] = (uint8_t)(a > 0 ? a * kGlintPeak : 0);
+        }
+    }
+    glint_dsc_.header.magic = LV_IMAGE_HEADER_MAGIC;
+    glint_dsc_.header.cf = LV_COLOR_FORMAT_ARGB8888;
+    glint_dsc_.header.w = sw;
+    glint_dsc_.header.h = strip_h;
+    glint_dsc_.header.stride = sw * 4;
+    glint_dsc_.data_size = sw * strip_h * 4;
+    glint_dsc_.data = glint_px_;
+}
