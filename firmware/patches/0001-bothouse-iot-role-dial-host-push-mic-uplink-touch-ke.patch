+#pragma once
+// rh dial (CONFIG_RH_DIAL): the round role dial of the hub web page (the bothouse-iot device service
+// rh/static/dial.html) drawn with LVGL on the board itself, covering the default xiaozhi
+// emoji / subtitle / status bar UI. Everything role-specific (id, name, colour, avatar
+// pictures) and the current state come from the host in {"type":"rh_dial",...} messages
+// (host side: rh/dial.py); the firmware is the same for every board.
+//
+// What is drawn over the character -- name tag, status chip (with the speaking bars, thinking dots,
+// interrupted stop square), battery arc, speech bubble, work status -- is cn_dial::DialOverlay from
+// the shared conest repo (firmware/dial/components/cn_dial_lvgl, conest's look and numbers). This
+// class only wires it to the host messages and draws what is still role-household's own: the
+// avatar, the glint and the edge ring.
+//
+// Frame rate: the avatar is a still full-screen picture and never moves; every animation only
+// touches small areas (the edge ring as a set of tiles, the pills, the glint strips), so a frame
+// redraws and sends a fraction of the 240x240 screen over SPI. Measured on the board 2026-10-19:
+// the first version (whole picture scaled every frame) ran at 6.5-18 frames/s.
+#include <sdkconfig.h>
+#if CONFIG_RH_DIAL
+
+#include "lcd_display.h"
+#include "lvgl_image.h"
+
+#include <cn_dial/dial_metrics.h>   // conest firmware/dial: screen profile + canvas units -> px
+#include <cn_dial/dial_overlay.h>   // conest firmware/dial: name tag, status chip, arc, bubble
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+
+class RhDialDisplay : public SpiLcdDisplay {
+public:
+    RhDialDisplay(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_handle_t panel, int width,
+                  int height, int offset_x, int offset_y, bool mirror_x, bool mirror_y,
+                  bool swap_xy, const cn_dial::ScreenProfile& screen);
+    ~RhDialDisplay();
+
+    void SetupUI() override;
+    void RhDial(const cJSON* msg) override;
+    void RhDeviceState(int state) override;
+    void RhDialLink(bool connected) override;
+    const cn_dial::ScreenProfile* GetScreenProfile() const override { return &metrics_.profile(); }
+    bool RhDialIdle() override;
+    // tts sentence_start text -> speech bubble (conest DECOR.md 2).
+    void SetChatMessage(const char* role, const char* content) override;
+    // Screen off while sleeping (conest patch 0011 SetPowerSaveMode): stop the dial animation and
+    // turn the panel off; the board fades the backlight out first.
+    void SetPowerSaveMode(bool on) override;
+
+private:
+    enum State { kIdle = 0, kThinking, kSpeaking, kInterrupted };
+    static constexpr int kTiles = 16;        // edge ring invalidated as this many small rectangles
+    static constexpr int kGlintStrips = 4;   // tilted glint band built from horizontal strips
+    // kTiles + 2 * kGlintStrips + a few overlay areas must stay under LVGL's LV_INV_BUF_SIZE (32
+    // invalid areas per frame); past that LVGL redraws the whole screen.
+
+    // Ring sizes come from here (cn_dial layout dial-layout.v1.json, rh_dial.* items), not from
+    // constants in this file; the overlay's come from cn_dial::OverlaySizes.
+    struct Sizes {
+        int ring_w;                                  // thinking / interrupted ring
+        int halo_min, halo_max, glow_min, glow_max;  // idle halo, speaking glow
+        int ring_max;                                // widest thing on the rim (glow_max) + 1 AA px
+    };
+    static Sizes MakeSizes(const cn_dial::DialMetrics& m);
+    // The board's profile with w/h taken from the panel (the panel size wins; a mismatch is logged).
+    static cn_dial::ScreenProfile PanelProfile(cn_dial::ScreenProfile p, int width, int height);
+    const cn_dial::DialMetrics metrics_;
+    const Sizes sz_;
+    // False when the profile is invalid or the screen is below cn_dial's smallest supported short
+    // side (layout min_short_side): then no dial is built and the default UI stays.
+    const bool usable_;
+    cn_dial::DialOverlay overlay_;
+
+    lv_obj_t* dial_ = nullptr;
+    lv_obj_t* face_base_ = nullptr;
+    lv_obj_t* face_think_ = nullptr;
+    lv_obj_t* glint_[kGlintStrips] = {};
+    lv_obj_t* edge_ = nullptr;     // custom-drawn: glow band, thinking arc, interrupted ring
+    lv_timer_t* timer_ = nullptr;
+    lv_image_dsc_t glint_dsc_ = {};
+    uint8_t* glint_px_ = nullptr;
+
+    // Everything below is touched only with the LVGL lock held (Tick runs in the LVGL task).
+    State state_ = kIdle;
+    std::atomic<bool> dial_idle_{true};  // state_ == kIdle, read by the power save timer task
+    int64_t state_since_ms_ = 0;
+    bool live_ = false;        // audio channel to the host is open
+    lv_color_t color_;
+    std::string role_;
+    int64_t last_ms_ = 0;
+    bool think_face_ = false;  // a separate thinking picture is shown (host sent a different URL)
+
+    // Smoothed animation values (0..1 unless noted).
+    float think_opa_ = 0, gray_ = 0, lvl_ = 0;
+    float halo_ = 0;           // idle breathing halo strength
+    float glow_ = 0;           // speaking glow strength
+    float spin_ = 0;           // thinking arc strength
+    float red_ = 0;            // interrupted ring strength
+    float rot_ = 0;            // thinking arc rotation, degrees
+    // What the edge drew last frame, to invalidate only when it changes.
+    int64_t edge_key_ = -1;
+    // Ring layers (see BuildRing): pixels within sz_.ring_max px of the rim, and three A8 layers.
+    // d16: depth below the rim in 1/16 px, < sz_.ring_max * 16. uint16_t: as uint8_t it wrapped
+    // from W = 1204 (ring_w 16, ring_max 17; conest firmware/dial TestRingDepth). Same 8 bytes.
+    struct RingPx { uint32_t idx; uint16_t ang10; uint16_t d16; };
+    RingPx* ring_px_ = nullptr;
+    int ring_n_ = 0;
+    uint8_t* layer_px_[3] = {};
