     switch (new_state) {
         case kDeviceStateUnknown:
@@ -1298,17 +1397,42 @@ void Application::WakeWordInvoke(const std::string& wake_word) {
 }
 
 bool Application::CanEnterSleepMode() {
+#if CONFIG_RH_ALWAYS_LISTEN
+    // rh: the board rests in Listening (it streams the mic to the host whenever idle), so resting
+    // Listening counts as idle here; the dial below says whether the role is doing anything.
+    if (GetDeviceState() != kDeviceStateIdle && GetDeviceState() != kDeviceStateListening) {
+        return false;
+    }
+#else
     if (GetDeviceState() != kDeviceStateIdle) {
         return false;
     }
+#endif
 
+#if !CONFIG_RH_HOST_PUSH
+    // conest patch 0011: with host push the audio channel stays open all the time.
     if (protocol_ && protocol_->IsAudioChannelOpened()) {
         return false;
     }
+#endif
 
+#if CONFIG_RH_ALWAYS_LISTEN
+    // Streaming mic packets pass through the encode queue all the time; only playback matters.
+    if (!audio_service_.IsPlaybackIdle()) {
+        return false;
+    }
+#else
     if (!audio_service_.IsIdle()) {
         return false;
     }
+#endif
+
+#if CONFIG_RH_DIAL
+    // rh: the role is thinking / speaking / was just interrupted (host-pushed dial state).
+    if (!Board::GetInstance().GetDisplay()->RhDialIdle()) {
+        return false;
+    }
+#endif
 
     // Now it is safe to enter sleep mode
     return true;
