+void RhDialDisplay::SetupUI() {
+    SpiLcdDisplay::SetupUI();  // default UI stays underneath (shown only in Wi-Fi config mode)
+    if (!usable_) return;      // logged in the constructor; dial_ stays nullptr, every entry point checks it
+    DisplayLockGuard lock(this);
+    const int W = width_, H = height_;
+    const int C = metrics_.canvas();
+
+    dial_ = lv_obj_create(lv_screen_active());
+    Plain(dial_);
+    lv_obj_set_size(dial_, W, H);
+    lv_obj_set_style_bg_color(dial_, lv_color_hex(kScreenBg), 0);
+    lv_obj_set_style_bg_opa(dial_, LV_OPA_COVER, 0);
+    lv_obj_set_style_text_color(dial_, lv_color_white(), 0);
+
+    // Faces: still pictures, canvas-sized (short side) on the canvas; on a non-square screen the
+    // bands around it show the dial background. The thinking one only exists when the host sends
+    // a different picture.
+    for (lv_obj_t** f : {&face_base_, &face_think_}) {
+        *f = lv_image_create(dial_);
+        lv_obj_remove_flag(*f, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(*f, C, C);
+        lv_obj_set_pos(*f, metrics_.canvas_x(), metrics_.canvas_y());
+    }
+    Show(face_think_, false);
+
+    BuildGlint();
+    for (int i = 0; i < kGlintStrips; i++) {
+        glint_[i] = lv_image_create(dial_);
+        lv_obj_remove_flag(glint_[i], LV_OBJ_FLAG_CLICKABLE);
+        if (glint_px_) lv_image_set_src(glint_[i], &glint_dsc_);
+        lv_obj_set_y(glint_[i], metrics_.canvas_y() + i * (C / kGlintStrips));
+        Show(glint_[i], false);
+    }
+
+    BuildRing();
+    edge_ = lv_obj_create(dial_);
+    Plain(edge_);
+    lv_obj_set_size(edge_, W, H);
+    lv_obj_center(edge_);
+    lv_obj_add_event_cb(edge_, EdgeDrawCb, LV_EVENT_DRAW_MAIN, this);
+
+    // Name tag, status chip, battery arc (only with a battery gauge), speech bubble, work status.
+    overlay_.Create(dial_, [](int& level, bool& charging) {
+        bool discharging = false;
+        return Board::GetInstance().GetBatteryLevel(level, charging, discharging);
+    });
+    overlay_.SetName("等待主机");
+
+    SetState(kIdle);
+    lv_obj_move_foreground(dial_);
+    last_ms_ = esp_timer_get_time() / 1000;
+    // The LVGL port task sleeps in whole FreeRTOS ticks plus one extra tick per loop. At the stock
+    // CONFIG_FREERTOS_HZ=100 that added 10-20 ms to every frame (measured 2026-10-19: 19-24 timer
+    // runs/s for a 33 ms period, frames/s capped at ~20 while speaking); the board's config.json
+    // now sets CONFIG_FREERTOS_HZ=1000 (as upstream esp-hi / sensecap-watcher do).
+    timer_ = lv_timer_create(TickCb, kFrameMs, this);
+    if (lv_timer_t* refr = lv_display_get_refr_timer(display_)) lv_timer_set_period(refr, kFrameMs);
+    stat_since_ms_ = last_ms_;
+    lv_display_add_event_cb(display_, RenderEventCb, LV_EVENT_RENDER_START, this);
+    lv_display_add_event_cb(display_, RenderEventCb, LV_EVENT_RENDER_READY, this);
+    ESP_LOGI(TAG, "rh dial: ready (%dx%d), waiting for host", W, H);
+}
