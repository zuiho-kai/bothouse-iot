@@ -2,10 +2,96 @@ menu "Xiaozhi Assistant"
 
 config OTA_URL
     string "Default OTA URL"
-    default "https://api.tenclass.net/xiaozhi/ota/"
+    # bothouse-iot: point to your own device service instead of xiaozhi.me cloud.
