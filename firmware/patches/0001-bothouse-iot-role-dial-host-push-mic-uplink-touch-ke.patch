+// The edge ring area as kTiles small rectangles hugging the circle, `width` px thick.
+// lo..hi: only tiles overlapping this angle range (degrees, 0 = 3 o'clock, clockwise; may wrap).
+void RhDialDisplay::InvalidateEdge(int width, float lo, float hi) {
+    const int W = width_, H = height_;
+    if (width != tiles_w_) {
+        tiles_w_ = width;
+        const float R = metrics_.safe_radius(), cx = metrics_.center_x(), cy = metrics_.center_y();
+        for (int i = 0; i < kTiles; i++) {
+            float x1 = 1e9f, y1 = 1e9f, x2 = -1e9f, y2 = -1e9f;
+            for (int s = 0; s <= 4; s++) {
+                float a = (i + s / 4.0f) * 2 * (float)M_PI / kTiles;
+                for (float r : {R, R - width}) {
+                    float x = cx + r * cosf(a), y = cy + r * sinf(a);
+                    x1 = std::min(x1, x); y1 = std::min(y1, y); x2 = std::max(x2, x); y2 = std::max(y2, y);
+                }
+            }
+            tiles_[i] = {std::max(0, (int)floorf(x1) - 2), std::max(0, (int)floorf(y1) - 2),
+                         std::min(W - 1, (int)ceilf(x2) + 2), std::min(H - 1, (int)ceilf(y2) + 2)};
+        }
+    }
+    const float step = 360.0f / kTiles;
+    for (int i = 0; i < kTiles; i++) {
+        if (hi - lo < 360) {
+            // tile i spans [i*step, (i+1)*step]; test overlap with [lo, hi] modulo 360
+            float a0 = fmodf(i * step - lo + 720, 360);
+            float a1 = a0 + step;
+            if (!(a0 <= hi - lo || a1 >= 360)) continue;
+        }
+        lv_obj_invalidate_area(edge_, &tiles_[i]);
+    }
+}
+
+// Precompute the pixels near the rim (distance < sz_.ring_max px) with their angle and distance, and
+// three A8 (alpha-only) full-screen layers: role colour, white, red. Each frame only those ring
+// pixels are rewritten, and the layers are blended with LVGL's A8 fast path (colour + mask),
+// clipped to the edge tiles -- no arc / circle masks are computed while drawing.
+void RhDialDisplay::BuildRing() {
+    const int W = width_, H = height_;
+    const float R = metrics_.safe_radius(), cx = metrics_.center_x(), cy = metrics_.center_y();
+    std::vector<RingPx> px;
+    for (int y = 0; y < H; y++) {
+        for (int x = 0; x < W; x++) {
+            float dx = x + .5f - cx, dy = y + .5f - cy;
+            float d = R - sqrtf(dx * dx + dy * dy);
+            if (d < 0 || d >= sz_.ring_max) continue;
+            // clockwise from 12 o'clock, 0.1 deg
+            float a = atan2f(dx, -dy) * 180 / (float)M_PI;
+            if (a < 0) a += 360;
+            px.push_back({(uint32_t)(y * W + x), (uint16_t)(a * 10), (uint16_t)(d * 16)});
+        }
+    }
+    std::sort(px.begin(), px.end(), [](const RingPx& a, const RingPx& b) { return a.d16 < b.d16; });
+    ring_n_ = px.size();
+    for (int w = 0; w <= sz_.ring_max; w++) {  // ring_upto_[w] = number of pixels closer than w px to the rim
+        ring_upto_[w] = std::lower_bound(px.begin(), px.end(), w * 16,
+                                         [](const RingPx& a, int v) { return a.d16 < v; }) - px.begin();
+    }
+    ring_px_ = static_cast<RingPx*>(heap_caps_malloc(ring_n_ * sizeof(RingPx), MALLOC_CAP_SPIRAM));
+    if (ring_px_) memcpy(ring_px_, px.data(), ring_n_ * sizeof(RingPx));
+    for (int l = 0; l < 3; l++) {
+        layer_px_[l] = static_cast<uint8_t*>(heap_caps_calloc(W * H, 1, MALLOC_CAP_SPIRAM));
+        auto& d = layer_dsc_[l];
+        d.header.magic = LV_IMAGE_HEADER_MAGIC;
+        d.header.cf = LV_COLOR_FORMAT_A8;
+        d.header.w = W;
+        d.header.h = H;
+        d.header.stride = W;
+        d.data_size = W * H;
+        d.data = layer_px_[l];
+    }
+}
+
+// Rewrite the ring pixels of the three layers from the current animation values.
+void RhDialDisplay::PaintRing(float halo_opa, float halo_w, float glow_opa, float glow_w, int upto) {
+    if (ring_px_ == nullptr || !layer_px_[0] || !layer_px_[1] || !layer_px_[2]) return;
+    const float ring_w = sz_.ring_w;  // web .ring: 6 px of 466
+    float band_o = std::max(halo_opa, glow_opa);
+    float band_w = glow_opa >= halo_opa ? glow_w : halo_w;
+    float rot10 = rot_ * 10;
+    const int n = ring_upto_[std::min(upto, sz_.ring_max)];
+    for (int i = 0; i < n; i++) {
+        const RingPx& p = ring_px_[i];
+        float d = p.d16 / 16.0f;
+        float col = 0, white = 0, red = 0;
+        // Glow band: strongest at the rim, fading inwards (smooth falloff), soft inner edge.
+        if (band_o > .004f && d < band_w) {
+            float u = 1 - d / band_w;
+            col = band_o * (.25f + .65f * u * u);
+        }
+        // Ring edge anti-aliasing for the 3 px rings.
+        float ring_a = Clamp01(ring_w - d);
+        if (spin_ > .004f && ring_a > 0) {
+            // conic-gradient(transparent 0 62%, colour 92%, #fff 100%), rotated by rot_
+            float th = fmodf(p.ang10 - rot10 + 7200, 3600) / 10;
+            if (th >= 223.2f) {
+                if (th < 331.2f) {
+                    col = std::max(col, spin_ * ring_a * (th - 223.2f) / 108);
+                } else {
+                    float m = (th - 331.2f) / 28.8f;
+                    col = std::max(col, spin_ * ring_a * (1 - m));
+                    white = spin_ * ring_a * m;
+                }
+            }
+        }
+        if (red_ > .004f) red = red_ * ring_a;
+        layer_px_[0][p.idx] = (uint8_t)(Clamp01(col) * 255);
+        layer_px_[1][p.idx] = (uint8_t)(Clamp01(white) * 255);
+        layer_px_[2][p.idx] = (uint8_t)(Clamp01(red) * 255);
+    }
+}
+
+void RhDialDisplay::EdgeDrawCb(lv_event_t* e) {
+    auto self = static_cast<RhDialDisplay*>(lv_event_get_user_data(e));
+    lv_layer_t* layer = lv_event_get_layer(e);
+    lv_area_t c;
+    lv_obj_get_coords(self->edge_, &c);
+    const lv_color_t colors[3] = {self->color_, lv_color_white(), lv_color_hex(kRed)};
+    for (int l = 0; l < 3; l++) {
+        if (!self->layer_on_[l] || !self->layer_px_[l]) continue;
+        lv_draw_image_dsc_t d;
+        lv_draw_image_dsc_init(&d);
+        d.src = &self->layer_dsc_[l];
+        d.recolor = colors[l];
+        d.recolor_opa = LV_OPA_COVER;
+        lv_draw_image(layer, &d, &c);
+    }
+}
+
+void RhDialDisplay::Tick() {
+    const int C = metrics_.canvas();
+    int64_t now_us = esp_timer_get_time();
+    int64_t now_ms = now_us / 1000;
+    double t = (double)now_ms;  // ms; reduced per cycle by Cyc/Ang/Wave (see above)
+    float dt = (float)std::min<int64_t>(200, now_ms - last_ms_);
+    last_ms_ = now_ms;
+    stat_ticks_++;
+
+    // Speaking level: real playback loudness, else the synthetic wave of dial.html level();
+    // then a fast-attack / slow-release filter so the glow follows syllables smoothly.
+    float raw = 0;
+    if (state_ == kSpeaking) {
+        if (now_us - g_rh_out_level_us.load() < kLevelFreshUs) {
+            raw = g_rh_out_level.load() / 1000.0f;
+        } else {
+            float kk = role_.empty() ? 0 : (float)(unsigned char)role_[0];
+            raw = .35f + .3f * fabsf(sinf(Ang(t, 110) + kk)) * (.6f + .4f * sinf(Ang(t, 370) + kk * 2));
+        }
+    }
+    lvl_ = Follow(lvl_, raw, dt, raw > lvl_ ? kTauLevelUp : kTauLevelDown);
+
+    halo_ = Follow(halo_, state_ == kIdle ? 1 : 0, dt, kTauRing);
+    glow_ = Follow(glow_, state_ == kSpeaking ? 1 : 0, dt, kTauRing);
+    spin_ = Follow(spin_, state_ == kThinking ? 1 : 0, dt, kTauRing);
+    red_ = Follow(red_, state_ == kInterrupted ? 1 : 0, dt, kTauRing);
+    if (spin_ > .01f) rot_ = fmodf(rot_ + 360 * dt / kSpinMs, 360);
+
+    // Edge: repaint the ring layers and invalidate the ring tiles only when something changes.
+    {
+        float b = Wave(t, kBreatheIdleMs);
+        float halo_opa = halo_ * (kHaloOpaMin + (kHaloOpaMax - kHaloOpaMin) * b);
+        float halo_w = sz_.halo_min + (sz_.halo_max - sz_.halo_min) * b;
+        float glow_opa = glow_ * (.4f + .6f * lvl_);
+        float glow_w = sz_.glow_min + (sz_.glow_max - sz_.glow_min) * lvl_;
+        // one A8 level of opacity, 1/8 px of width, 1/2 degree of rotation
+        int64_t key = (int64_t)(halo_opa * 255) + 256 * ((int64_t)(halo_w * 8) + 256 * ((int64_t)(glow_opa * 255) +
+                      256 * ((int64_t)(glow_w * 8) + 256 * ((int64_t)(red_ * 255) + 256 * ((int64_t)(spin_ * 255) +
+                      256 * (spin_ > .004f ? (int64_t)(rot_ * 2) : 0))))));
+        if (key != edge_key_) {
+            edge_key_ = key;
+            // Only as deep into the circle as anything is drawn now or was drawn last time.
+            const int ring_w = sz_.ring_w;
+            int need = 0;
+            if (halo_opa > .004f) need = (int)ceilf(halo_w);
+            if (glow_opa > .004f) need = std::max(need, (int)ceilf(glow_w));
+            if (spin_ > .004f || red_ > .004f) need = std::max(need, ring_w);
+            need = std::min(sz_.ring_max, need + 1);
+            int depth = std::max(need, ring_depth_);
+            PaintRing(halo_opa, halo_w, glow_opa, glow_w, depth);
+            layer_on_[0] = halo_opa > .004f || glow_opa > .004f || spin_ > .004f;
+            layer_on_[1] = spin_ > .004f;
+            layer_on_[2] = red_ > .004f;
+            // Steady thinking: only the turning arc moves -> only tiles under its old and new span.
+            bool only_arc = state_ == kThinking && spin_ > .99f && halo_ < .004f && glow_ < .004f && red_ < .004f &&
+                            depth == ring_depth_;
+            if (only_arc) {
+                float lo = arc_drawn_rot_ + 223.2f - 90 - 2;   // conic 0 = 12 o'clock, tiles 0 = 3 o'clock
+                float hi = rot_ + 360 - 90 + 2;
+                if (hi < lo) hi += 360;
+                InvalidateEdge(depth, fmodf(lo + 360, 360), fmodf(lo + 360, 360) + std::min(360.0f, hi - lo));
+            } else {
+                InvalidateEdge(depth, 0, 360);
+            }
+            arc_drawn_rot_ = rot_;
+            ring_depth_ = need;
+        }
+    }
+
+    // Thinking picture cross-fade (only when the host sent a different one) and the interrupted
+    // grey-out: both repaint the whole picture, so they move in a few coarse steps.
+    if (think_face_) {
+        think_opa_ = Follow(think_opa_, state_ == kThinking ? 1 : 0, dt, kTauFace);
+        Num(face_think_, LV_STYLE_IMAGE_OPA, (int32_t)lroundf(think_opa_ * 8) * 255 / 8);
+    }
+    gray_ = Follow(gray_, state_ == kInterrupted ? 1 : 0, dt, kTauGray);
+    // grayscale(.6) brightness(.75) -> blend towards dark grey
+    Col(face_base_, LV_STYLE_IMAGE_RECOLOR, lv_color_hex(0x3a3a3a));
+    Num(face_base_, LV_STYLE_IMAGE_RECOLOR_OPA, (int32_t)lroundf(gray_ * 6) * 115 / 6);
+
+    // Glint: idle only, sweeps during 78%..92% of each 9 s cycle, eased.
+    {
+        float u = Cyc(t, kGlintMs) / kGlintMs;
+        bool on = state_ == kIdle && u >= .78f && u <= .92f && glint_px_;
+        // band centre at mid height, across the canvas
+        float cx = metrics_.canvas_x() + (-0.6f + 2.25f * Smooth((u - .78f) / .14f)) * C;
+        int sh = C / kGlintStrips;
+        for (int i = 0; i < kGlintStrips; i++) {
+            if (on) {
+                float row = i * sh + sh / 2.0f;
+                Num(glint_[i], LV_STYLE_X, (int32_t)lroundf(cx - (row - C / 2.0f) * kGlintTan - glint_dsc_.header.w / 2.0f));
+            }
+            if (on != !lv_obj_has_flag(glint_[i], LV_OBJ_FLAG_HIDDEN)) Show(glint_[i], on);
+        }
+    }
+
+    // Name tag, status chip (bars, dots, fade), bubble.
+    overlay_.Tick(t, dt, lvl_);
+
+    if (now_ms - stat_since_ms_ >= 30000) ReportStats(now_ms, "periodic");
+}
+
+void RhDialDisplay::RhDial(const cJSON* msg) {
+    auto str = [msg](const char* key) -> const char* {
+        auto j = cJSON_GetObjectItem(msg, key);
+        return cJSON_IsString(j) ? j->valuestring : nullptr;
+    };
+    const char* role = str("role");
+    const char* name = str("name");
+    const char* color = str("color");
+    const char* state = str("state");
+    const char* avatar = str("avatar");
+    const char* avatar_think = str("avatar_think");
+    auto live = cJSON_GetObjectItem(msg, "live");
+    // conest DECOR.md 3: {"conest_status":{"busy":bool}}, the role's agent is working on a turn.
+    auto status = cJSON_GetObjectItem(msg, "conest_status");
+    auto busy = cJSON_IsObject(status) ? cJSON_GetObjectItem(status, "busy") : nullptr;
+    // conest patch 0011: anything the role does (thinking, speaking, interrupted) lights the screen.
+    if (state && strcmp(state, "idle") != 0) Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    {
+        DisplayLockGuard lock(this);
+        if (dial_ == nullptr) return;
+        if (role) role_ = role;
+        if (name) overlay_.SetName(name);
+        if (cJSON_IsBool(busy)) overlay_.SetBusy(cJSON_IsTrue(busy));
+        if (color && color[0] == '#' && strlen(color) == 7) color_ = lv_color_hex(strtoul(color + 1, nullptr, 16));
+        if (cJSON_IsBool(live)) {
+            live_ = cJSON_IsTrue(live);
+            overlay_.SetLink(live_);
+        }
+        if (state) {
+            State s = strcmp(state, "thinking") == 0      ? kThinking
+                      : strcmp(state, "speaking") == 0    ? kSpeaking
+                      : strcmp(state, "interrupted") == 0 ? kInterrupted
+                                                          : kIdle;
+            if (s != state_) SetState(s);
+        }
+    }
+    ESP_LOGI(TAG, "rh dial: host says role=%s name=%s state=%s", role ? role : "-", name ? name : "-",
+             state ? state : "-");
+    if (avatar) {
+        std::string think = avatar_think ? avatar_think : avatar;
+        if (think == avatar) {  // no separate thinking picture: no cross-fade (saves full repaints)
+            DisplayLockGuard lock(this);
+            ClearThinkFace();
+            think = "";
+        }
+        RequestAvatars(avatar, think);
+    }
+}
+
+void RhDialDisplay::RhDeviceState(int state) {
+    // conest patch 0011: leaving idle lights the screen. With RH_ALWAYS_LISTEN the board rests in
+    // Listening (it streams the mic to the host all the time), so Listening alone does not count.
+    bool active = state != kDeviceStateIdle;
+#if CONFIG_RH_ALWAYS_LISTEN
+    if (state == kDeviceStateListening) active = false;
+#endif
+    if (active) Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    DisplayLockGuard lock(this);
+    if (dial_ == nullptr) return;
+    // Wi-Fi config mode needs the default screen (hotspot name / address instructions).
+    if (state == kDeviceStateWifiConfiguring) lv_obj_add_flag(dial_, LV_OBJ_FLAG_HIDDEN);
+    else lv_obj_remove_flag(dial_, LV_OBJ_FLAG_HIDDEN);
+}
+
+void RhDialDisplay::RhDialLink(bool connected) {
+    {
+        DisplayLockGuard lock(this);
+        if (dial_ == nullptr) return;
+        live_ = connected;
+        overlay_.SetLink(connected);
+        if (!connected && state_ != kIdle) SetState(kIdle);
+        if (!connected) overlay_.SetSpeech(nullptr);
+    }
+    if (!connected) {  // fetch the pictures again after reconnecting (the host may have new ones)
+        xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+        have_base_url_.clear();
+        have_think_url_.clear();
+        xSemaphoreGive(dl_mutex_);
+    }
+}
+
+bool RhDialDisplay::RhDialIdle() { return dial_idle_.load(); }
+
+// application.cc delivers each tts "sentence_start" text through SetChatMessage() (main task).
+// Keep the base (hidden) subtitle in sync and mirror the sentence into the bubble (conest 0010).
+void RhDialDisplay::SetChatMessage(const char* role, const char* content) {
+    SpiLcdDisplay::SetChatMessage(role, content);
+    if (role == nullptr || strcmp(role, "assistant") != 0) return;
+    const bool text = content != nullptr && content[0] != '\0';
+    if (text) Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);  // conest 0011
+    DisplayLockGuard lock(this);
+    if (dial_ == nullptr) return;
+    overlay_.SetSpeech(text ? content : nullptr);
+}
+
+// conest patch 0011 SetPowerSaveMode: pause the animation (the CNAS player there, the dial timer
+// here) and switch the panel off; on wake resume and redraw everything once.
+void RhDialDisplay::SetPowerSaveMode(bool on) {
+    DisplayLockGuard lock(this);
+    if (timer_) {
+        if (on) {
+            lv_timer_pause(timer_);
+        } else {
+            last_ms_ = esp_timer_get_time() / 1000;  // no jump in the smoothing after the pause
+            lv_timer_resume(timer_);
+        }
+    }
+    if (panel_) esp_lcd_panel_disp_on_off(panel_, !on);
+    if (!on) lv_obj_invalidate(lv_screen_active());
+}
+
+void RhDialDisplay::RequestAvatars(const std::string& base, const std::string& think) {
+    xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+    want_base_url_ = base;
+    want_think_url_ = think;
+    bool start = !dl_running_ && (want_base_url_ != have_base_url_ || want_think_url_ != have_think_url_);
+    if (start) dl_running_ = true;
+    xSemaphoreGive(dl_mutex_);
+    if (start && xTaskCreate(DownloadTask, "rh_dial_dl", 8192, this, 2, nullptr) != pdPASS) {
+        ESP_LOGE(TAG, "rh dial: cannot start download task");
+        xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+        dl_running_ = false;
+        xSemaphoreGive(dl_mutex_);
+    }
+}
+
+void RhDialDisplay::DownloadTask(void* arg) {
+    auto self = static_cast<RhDialDisplay*>(arg);
+    while (true) {
+        xSemaphoreTake(self->dl_mutex_, portMAX_DELAY);
+        bool think = false;
+        std::string url;
+        if (self->want_base_url_ != self->have_base_url_) {
+            url = self->have_base_url_ = self->want_base_url_;
+        } else if (self->want_think_url_ != self->have_think_url_) {
+            url = self->have_think_url_ = self->want_think_url_;
+            think = true;
+        } else {
+            self->dl_running_ = false;
+            xSemaphoreGive(self->dl_mutex_);
+            break;
+        }
+        xSemaphoreGive(self->dl_mutex_);
+        if (url.empty()) {  // host dropped this picture: nothing to fetch, free the old one
+            if (think) {
+                DisplayLockGuard lock(self);
+                self->ClearThinkFace();
+            }
+            continue;
+        }
+        auto image = self->Download(url);
+        if (!image) continue;
+        // The host may have asked for another picture while this one downloaded: only show it
+        // if it is still the wanted one (else the loop fetches the new one / clears it).
+        xSemaphoreTake(self->dl_mutex_, portMAX_DELAY);
+        bool still = (think ? self->want_think_url_ : self->want_base_url_) == url;
+        xSemaphoreGive(self->dl_mutex_);
+        if (!still) {
+            ESP_LOGI(TAG, "rh dial: %s picture changed during download, dropped", think ? "thinking" : "base");
+            continue;
+        }
+        DisplayLockGuard lock(self);
+        if (think) self->SetFace(self->face_think_, self->img_think_, std::move(image));
+        else self->SetFace(self->face_base_, self->img_base_, std::move(image));
+    }
+    vTaskDelete(nullptr);
+}
+
+// No separate thinking picture any more: hide it and free its pixels (display lock held).
+void RhDialDisplay::ClearThinkFace() {
+    think_face_ = false;
+    Show(face_think_, false);
+    if (img_think_) {
+        lv_image_set_src(face_think_, nullptr);
+        lv_image_cache_drop(img_think_->image_dsc());
+        img_think_.reset();
+    }
+}
+
+void RhDialDisplay::SetFace(lv_obj_t* img, std::unique_ptr<LvglImage>& slot, std::unique_ptr<LvglImage> image) {
+    lv_image_set_src(img, image->image_dsc());
+    if (img == face_think_) {
+        think_face_ = true;
+        think_opa_ = state_ == kThinking ? 1 : 0;
+        lv_obj_set_style_image_opa(face_think_, (lv_opa_t)(think_opa_ * 255), 0);
+        Show(face_think_, true);
+    }
+    if (slot) lv_image_cache_drop(slot->image_dsc());
+    slot = std::move(image);
+}
+
+// Host serves the picture already sized for the canvas (short side x short side) as raw
+// little-endian RGB565 (rh/dial.py): no decoder needed on the board.
+std::unique_ptr<LvglImage> RhDialDisplay::Download(const std::string& base_url) {
+    const int C = metrics_.canvas();
+    const size_t want = (size_t)C * C * 2;
+    std::string url = base_url + (base_url.find('?') == std::string::npos ? "?" : "&") + "size=" + std::to_string(C);
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp(3);
+    if (auto opened = http->Open("GET", url); !opened) {
+        ESP_LOGE(TAG, "rh dial: cannot open %s", url.c_str());
+        return nullptr;
+    }
+    auto status = http->GetStatusCode();
+    if (!status || *status != 200 || http->GetBodyLength() != want) {
+        ESP_LOGE(TAG, "rh dial: %s -> status %d, %u bytes (want %u)", url.c_str(), status ? *status : -1,
+                 (unsigned)http->GetBodyLength(), (unsigned)want);
+        http->Close();
+        return nullptr;
+    }
+    auto data = static_cast<uint8_t*>(heap_caps_malloc(want, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (data == nullptr) {
+        ESP_LOGE(TAG, "rh dial: no memory for %u bytes", (unsigned)want);
+        http->Close();
+        return nullptr;
+    }
+    size_t got = 0;
+    while (got < want) {
+        auto n = http->Read(reinterpret_cast<char*>(data) + got, want - got);
+        if (!n || *n <= 0) break;
+        got += *n;
+    }
+    http->Close();
+    if (got != want) {
+        ESP_LOGE(TAG, "rh dial: %s short read %u/%u", url.c_str(), (unsigned)got, (unsigned)want);
+        heap_caps_free(data);
+        return nullptr;
+    }
+    ESP_LOGI(TAG, "rh dial: avatar %s (%u bytes)", url.c_str(), (unsigned)got);
+    return std::make_unique<LvglAllocatedImage>(data, want, C, C, C * 2, LV_COLOR_FORMAT_RGB565);
+}
