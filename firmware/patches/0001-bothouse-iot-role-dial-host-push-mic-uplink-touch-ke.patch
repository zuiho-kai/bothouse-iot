+// Runs in the LVGL task (lock held).
+void RhDialDisplay::SetState(State s) {
+    if (stat_since_ms_) ReportStats(esp_timer_get_time() / 1000, "state");
+    state_ = s;
+    dial_idle_.store(s == kIdle);
+    state_since_ms_ = esp_timer_get_time() / 1000;
+    using Chip = cn_dial::DialOverlay::Chip;
+    static const Chip chip[] = {Chip::kNone, Chip::kThinking, Chip::kSpeaking, Chip::kInterrupted};
+    overlay_.SetChip(chip[s]);
+    if (s != kIdle) {
+        for (auto g : glint_) Show(g, false);
+    }
