+RhDialDisplay::Sizes RhDialDisplay::MakeSizes(const cn_dial::DialMetrics& m) {
+    namespace L = cn_dial::layout;
+    Sizes z{};
+    z.ring_w = m.px(L::kRhDialRingWidth);
+    z.halo_min = m.px(L::kRhDialHaloMin);
+    z.halo_max = m.px(L::kRhDialHaloMax);
+    z.glow_min = m.px(L::kRhDialGlowMin);
+    z.glow_max = m.px(L::kRhDialGlowMax);
+    z.ring_max = std::max(z.glow_max, std::max(z.halo_max, z.ring_w)) + 1;
