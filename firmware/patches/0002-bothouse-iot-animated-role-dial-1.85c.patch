+// ---------- animated face ----------
+namespace {
+constexpr int kMouthOpenUp = 550, kMouthHalfUp = 180;     // level x1000: same steps as dial-figure.js mouthFromLevel
+constexpr int kMouthOpenDown = 420, kMouthHalfDown = 80;  // (with hysteresis so the mouth does not flicker)
+int Want(int kind, int idx) { return kind << 8 | idx; }
+}  // namespace
+
+void RhDialDisplay::RequestAnim(const std::string& url) {
+    xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+    want_anim_url_ = url;
+    bool start = !anim_dl_running_ && want_anim_url_ != have_anim_url_;
+    if (start) anim_dl_running_ = true;
+    xSemaphoreGive(dl_mutex_);
+    if (start && xTaskCreate(AnimDownloadTask, "rh_dial_anim", 8192, this, 2, nullptr) != pdPASS) {
+        ESP_LOGE(TAG, "rh dial: cannot start animation download task");
+        xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+        anim_dl_running_ = false;
+        xSemaphoreGive(dl_mutex_);
+    }
+}
+
+void RhDialDisplay::AnimDownloadTask(void* arg) {
+    auto self = static_cast<RhDialDisplay*>(arg);
+    const int C = self->metrics_.canvas();
+    while (true) {
+        xSemaphoreTake(self->dl_mutex_, portMAX_DELAY);
+        if (self->want_anim_url_ == self->have_anim_url_) {
+            self->anim_dl_running_ = false;
+            xSemaphoreGive(self->dl_mutex_);
+            break;
+        }
+        std::string base = self->have_anim_url_ = self->want_anim_url_;
+        xSemaphoreGive(self->dl_mutex_);
+        std::string url = base + (base.find('?') == std::string::npos ? "?" : "&") + "size=" + std::to_string(C);
+        auto http = Board::GetInstance().GetNetwork()->CreateHttp(3);
+        if (!http->Open("GET", url)) {
+            ESP_LOGE(TAG, "rh dial: cannot open %s", url.c_str());
+            continue;
+        }
+        auto status = http->GetStatusCode();
+        size_t len = http->GetBodyLength();
+        // A pack for a 360 px screen is about 1 MB (tools/dial_frames.py); refuse anything past 4 MB.
+        if (!status || *status != 200 || len < 8 || len > 4 * 1024 * 1024) {
+            ESP_LOGW(TAG, "rh dial: no animation at %s (status %d, %u bytes): keeping the still picture", url.c_str(),
+                     status ? *status : -1, (unsigned)len);
+            http->Close();
+            continue;
+        }
+        auto data = static_cast<uint8_t*>(heap_caps_malloc(len, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (!data) {
+            ESP_LOGE(TAG, "rh dial: no PSRAM for the %u byte animation", (unsigned)len);
+            http->Close();
+            continue;
+        }
+        size_t got = 0;
+        while (got < len) {
+            auto n = http->Read(reinterpret_cast<char*>(data) + got, len - got);
+            if (!n || *n <= 0) break;
+            got += *n;
+        }
+        http->Close();
+        auto anim = std::make_unique<RhDialAnim>();
+        if (got != len || !anim->Load(data, len, C)) {   // Load owns data from here
+            ESP_LOGE(TAG, "rh dial: animation %s unusable (%u/%u bytes)", url.c_str(), (unsigned)got, (unsigned)len);
+            continue;
+        }
+        self->InstallAnim(std::move(anim));
+    }
+    vTaskDelete(nullptr);
+}
+
+// Called from the download task: buffers and mouth crops are prepared outside the LVGL lock.
+void RhDialDisplay::InstallAnim(std::unique_ptr<RhDialAnim> anim) {
+    const int C = metrics_.canvas();
+    const size_t frame = (size_t)C * C * 2;
+    // stop the decode task before touching buffers or dropping an older pack it may be reading
+    anim_installing_ = true;
+    anim_want_ = -1;
+    while (anim_busy_) vTaskDelay(1);
+    struct Done { std::atomic<bool>& f; ~Done() { f = false; } } done{anim_installing_};
+    for (auto& b : anim_buf_) {
+        if (!b) b = static_cast<uint8_t*>(heap_caps_aligned_alloc(16, frame, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (!b) {
+            ESP_LOGE(TAG, "rh dial: no PSRAM for animation frames");
+            return;
+        }
+    }
+    uint8_t* mouths[3] = {};
+    const auto& r = anim->mouth();
+    if (anim->Count(RhDialAnim::kMouth) == 3) {
+        for (int i = 0; i < 3; i++) {
+            mouths[i] = static_cast<uint8_t*>(heap_caps_aligned_alloc(16, (size_t)r.w * r.h * 2 + 64, MALLOC_CAP_SPIRAM));
+            if (!mouths[i] || !anim->Decode(RhDialAnim::kMouth, i, mouths[i], (size_t)r.w * r.h * 2 + 64)) {
+                for (auto& m : mouths) { if (m) heap_caps_free(m); m = nullptr; }
+                break;
+            }
+        }
+    }
+    // the first idle frame goes into the buffer not on screen before the swap: never a blank picture
+    const int slot = anim_ ? 1 - anim_front_ : 0;
+    if (!anim->Decode(RhDialAnim::kIdle, 0, anim_buf_[slot], frame)) {
+        for (auto& m : mouths) if (m) heap_caps_free(m);
+        return;
+    }
+    DisplayLockGuard lock(this);
+    for (int i = 0; i < 2; i++) {
+        anim_dsc_[i] = {};
+        anim_dsc_[i].header.magic = LV_IMAGE_HEADER_MAGIC;
+        anim_dsc_[i].header.cf = LV_COLOR_FORMAT_RGB565;
+        anim_dsc_[i].header.w = C;
+        anim_dsc_[i].header.h = C;
+        anim_dsc_[i].header.stride = C * 2;
+        anim_dsc_[i].data = anim_buf_[i];
+        anim_dsc_[i].data_size = frame;
+    }
+    for (int i = 0; i < 3; i++) {
+        if (mouth_px_[i]) heap_caps_free(mouth_px_[i]);
+        mouth_px_[i] = mouths[i];
+    }
+    anim_ = std::move(anim);
+    anim_front_ = slot;
+    anim_kind_ = RhDialAnim::kIdle;
+    anim_idx_ = 0;
+    mouth_shown_ = -1;
+    anim_ready_ = -1;
+    anim_want_ = -1;
+    lv_image_cache_drop(&anim_dsc_[slot]);
+    lv_image_set_src(face_base_, &anim_dsc_[slot]);
+    ClearThinkFace();   // the thinking loop replaces the thinking picture
+    if (!anim_task_) xTaskCreate(AnimDecodeTask, "rh_dial_dec", 6144, this, 3, &anim_task_);
+    ESP_LOGI(TAG, "rh dial: animated face on (%d fps)", anim_->fps());
+}
+
+void RhDialDisplay::AnimDecodeTask(void* arg) {
+    auto self = static_cast<RhDialDisplay*>(arg);
+    const int C = self->metrics_.canvas();
+    while (true) {
+        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+        self->anim_busy_ = true;
+        int want = self->anim_want_.load();
+        if (want >= 0 && self->anim_ && !self->anim_installing_) {
+            int64_t t0 = esp_timer_get_time();
+            // the back buffer is the one not on screen; Tick only swaps after anim_ready_ says so
+            uint8_t* back = self->anim_buf_[1 - self->anim_front_];
+            if (self->anim_->Decode((RhDialAnim::Kind)(want >> 8), want & 0xff, back, (size_t)C * C * 2)) {
+                self->stat_decode_us_ += esp_timer_get_time() - t0;
+                self->stat_decodes_++;
+                self->anim_ready_ = want;
+            }
+        }
+        self->anim_busy_ = false;
+    }
+}
+
+void RhDialDisplay::TickAnim(int64_t now_ms) {
+    const int C = metrics_.canvas();
+    int kind = state_ == kThinking ? RhDialAnim::kThink : state_ == kSpeaking ? RhDialAnim::kTalk : RhDialAnim::kIdle;
+    if (anim_->Count((RhDialAnim::Kind)kind) == 0) kind = RhDialAnim::kIdle;
+    int n = anim_->Count((RhDialAnim::Kind)kind);
+    // next frame: the following one of this loop, or the first of the new state's loop
+    int next = kind == anim_kind_ ? (anim_idx_ + 1) % n : 0;
+    bool still = kind == RhDialAnim::kTalk && kind == anim_kind_;   // speaking: one still picture
+    if (!still) {
+        int want = Want(kind, next);
+        if (anim_want_.load() != want && anim_ready_.load() != want) {
+            anim_want_ = want;
+            xTaskNotifyGive(anim_task_);
+        }
+        bool due = now_ms >= anim_due_ms_ || kind != anim_kind_;
+        if (due && anim_ready_.load() == want) {
+            anim_front_ = 1 - anim_front_;
+            lv_image_cache_drop(&anim_dsc_[anim_front_]);
+            lv_image_set_src(face_base_, &anim_dsc_[anim_front_]);
+            anim_kind_ = kind;
+            anim_idx_ = next;
+            anim_ready_ = -1;
+            mouth_shown_ = -1;
+            anim_due_ms_ = now_ms + 1000 / anim_->fps();
+            stat_anim_frames_++;
+            // ask for the one after right away: decoding runs while this frame is shown
+            int after = kind == RhDialAnim::kTalk ? -1 : Want(kind, (next + 1) % n);
+            if (after >= 0) {
+                anim_want_ = after;
+                xTaskNotifyGive(anim_task_);
+            }
+        }
+    }
+    // mouth: copy the crop for this level into the picture on screen and repaint just that block
+    if (anim_kind_ == RhDialAnim::kTalk && mouth_px_[0]) {
+        int lv = (int)(lvl_ * 1000);
+        int m = mouth_shown_ < 0 ? 0 : mouth_shown_;
+        if (m == 2) m = lv > kMouthOpenDown ? 2 : lv > kMouthHalfDown ? 1 : 0;
+        else if (m == 1) m = lv > kMouthOpenUp ? 2 : lv > kMouthHalfDown ? 1 : 0;
+        else m = lv > kMouthOpenUp ? 2 : lv > kMouthHalfUp ? 1 : 0;
+        if (m != mouth_shown_) {
+            const auto& r = anim_->mouth();
+            uint8_t* dst = anim_buf_[anim_front_];
+            for (int y = 0; y < r.h; y++) {
+                memcpy(dst + ((size_t)(r.y + y) * C + r.x) * 2, mouth_px_[m] + (size_t)y * r.w * 2, (size_t)r.w * 2);
+            }
+            lv_image_cache_drop(&anim_dsc_[anim_front_]);
+            lv_area_t a = {(int32_t)(metrics_.canvas_x() + r.x), (int32_t)(metrics_.canvas_y() + r.y),
+                           (int32_t)(metrics_.canvas_x() + r.x + r.w - 1), (int32_t)(metrics_.canvas_y() + r.y + r.h - 1)};
+            lv_obj_invalidate_area(face_base_, &a);
+            mouth_shown_ = m;
+            stat_anim_frames_++;
+        }
+    }
+}
