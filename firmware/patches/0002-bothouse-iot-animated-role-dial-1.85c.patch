diff --git a/main/display/rh_dial_anim.cc b/main/display/rh_dial_anim.cc
new file mode 100644
index 0000000..24da851
--- /dev/null
+++ b/main/display/rh_dial_anim.cc
@@ -0,0 +1,92 @@
+#include "rh_dial_anim.h"
+#if CONFIG_RH_DIAL
+
+#include <esp_heap_caps.h>
+#include <esp_jpeg_dec.h>
+#include <esp_log.h>
+
+#include <cstring>
+
+#define TAG "RhDialAnim"
+
+namespace {
+uint16_t U16(const uint8_t* p) { return p[0] | p[1] << 8; }
+uint32_t U32(const uint8_t* p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+}  // namespace
+
+RhDialAnim::~RhDialAnim() {
+    if (data_) heap_caps_free(data_);
+}
+
+bool RhDialAnim::Load(uint8_t* data, size_t len, int size) {
+    if (data_) heap_caps_free(data_);
+    data_ = data;
+    len_ = len;
+    for (auto& s : sets_) s.clear();
+    if (len < 8 || memcmp(data, "RHA1", 4) != 0) {
+        ESP_LOGE(TAG, "not an RHA1 pack (%u bytes)", (unsigned)len);
+        return false;
+    }
+    size_ = U16(data + 4);
+    fps_ = data[6];
+    int nsets = data[7];
+    if (size_ != size || fps_ <= 0) {
+        ESP_LOGE(TAG, "pack is %d px @ %d fps, canvas is %d px", size_, fps_, size);
+        return false;
+    }
+    size_t off = 8;
+    for (int s = 0; s < nsets; s++) {
+        if (off + 11 > len) return false;
+        int kind = data[off], n = U16(data + off + 1);
+        Rect r{U16(data + off + 3), U16(data + off + 5), U16(data + off + 7), U16(data + off + 9)};
+        off += 11;
+        std::vector<Frame> frames;
+        for (int i = 0; i < n; i++) {
+            if (off + 4 > len) return false;
+            uint32_t m = U32(data + off);
+            off += 4;
+            if (off + m > len) return false;
+            frames.push_back({data + off, m});
+            off += m;
+        }
+        if (kind >= 0 && kind < kKinds) {
+            sets_[kind] = std::move(frames);
+            if (kind == kMouth) mouth_ = r;
+        }
+    }
+    // The mouth block must lie inside the canvas, else the blit would write past the frame.
+    if (mouth_.w <= 0 || mouth_.h <= 0 || mouth_.x + mouth_.w > size_ || mouth_.y + mouth_.h > size_) {
+        sets_[kMouth].clear();
+    }
+    ESP_LOGI(TAG, "pack %d px @ %d fps: idle %d, thinking %d, speaking %d, mouth %d (%dx%d at %d,%d), %u KB", size_, fps_,
+             Count(kIdle), Count(kThink), Count(kTalk), Count(kMouth), mouth_.w, mouth_.h, mouth_.x, mouth_.y,
+             (unsigned)(len / 1024));
+    return Count(kIdle) > 0;
+}
+
+bool RhDialAnim::Decode(Kind k, int i, uint8_t* dst, size_t cap) const {
+    if (i < 0 || i >= Count(k)) return false;
+    const Frame& f = sets_[k][i];
+    jpeg_dec_config_t cfg = DEFAULT_JPEG_DEC_CONFIG();
+    cfg.output_type = JPEG_PIXEL_FORMAT_RGB565_LE;
+    jpeg_dec_handle_t dec = nullptr;
+    if (jpeg_dec_open(&cfg, &dec) != JPEG_ERR_OK) return false;
+    jpeg_dec_io_t io = {};
+    io.inbuf = const_cast<uint8_t*>(f.p);
+    io.inbuf_len = (int)f.n;
+    jpeg_dec_header_info_t info = {};
+    bool ok = jpeg_dec_parse_header(dec, &io, &info) == JPEG_ERR_OK;
+    int need = 0;
+    ok = ok && jpeg_dec_get_outbuf_len(dec, &need) == JPEG_ERR_OK && need > 0 && (size_t)need <= cap;
+    int want_w = k == kMouth ? mouth_.w : size_, want_h = k == kMouth ? mouth_.h : size_;
+    ok = ok && info.width == want_w && info.height == want_h;
+    if (ok) {
+        io.outbuf = dst;
+        ok = jpeg_dec_process(dec, &io) == JPEG_ERR_OK;
+    }
+    jpeg_dec_close(dec);
+    if (!ok) ESP_LOGW(TAG, "frame %d/%d did not decode (%dx%d, need %d of %u)", k, i, info.width, info.height, need, (unsigned)cap);
+    return ok;
+}
+
+#endif  // CONFIG_RH_DIAL
diff --git a/main/display/rh_dial_anim.h b/main/display/rh_dial_anim.h
new file mode 100644
index 0000000..b09a5f7
--- /dev/null
+++ b/main/display/rh_dial_anim.h
@@ -0,0 +1,42 @@
+#pragma once
+// rh dial animation pack (CONFIG_RH_DIAL): loops recorded offline from the web dial's animated
+// figure (bothouse-iot tools/dial_frames.py) and served by the device service as
+// /xiaozhi/dial/<role>.anim?size=<canvas>. Little endian:
+//   "RHA1" | u16 size | u8 fps | u8 nsets
+//   per set: u8 kind | u16 n | u16 x, y, w, h (mouth set only) | n x (u32 len + JPEG)
+//   kinds: 0 idle loop, 1 thinking loop, 2 speaking still, 3 mouth crops (closed, half, open)
+// Speaking shows the still and only repaints the mouth block, picked by the playback level.
+#include <sdkconfig.h>
+#if CONFIG_RH_DIAL
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+class RhDialAnim {
+public:
+    enum Kind { kIdle = 0, kThink = 1, kTalk = 2, kMouth = 3, kKinds = 4 };
+    struct Rect { int x = 0, y = 0, w = 0, h = 0; };
+
+    ~RhDialAnim();
+    // Takes ownership of `data` (heap_caps_malloc). False when the pack is malformed, is not for a
+    // `size` px canvas, or lacks the idle loop.
+    bool Load(uint8_t* data, size_t len, int size);
+    int fps() const { return fps_; }
+    int size() const { return size_; }
+    int Count(Kind k) const { return (int)sets_[k].size(); }
+    const Rect& mouth() const { return mouth_; }
+    // Frame i of set k as RGB565 little endian into dst (16-byte aligned, cap bytes). The decoded
+    // size is size x size, or the mouth rect for kMouth. Safe from any task (own decoder handle).
+    bool Decode(Kind k, int i, uint8_t* dst, size_t cap) const;
+
+private:
+    struct Frame { const uint8_t* p; uint32_t n; };
+    uint8_t* data_ = nullptr;
+    size_t len_ = 0;
+    int size_ = 0, fps_ = 0;
+    std::vector<Frame> sets_[kKinds];
+    Rect mouth_;
+};
+
+#endif  // CONFIG_RH_DIAL
